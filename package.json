{
  "name": "delta-board",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test --project=chromium --project=chromium-mobile --project=chromium-breakpoint",
    "test:browser:cross": "playwright test tests/browser/behavior.spec.js tests/browser/accessibility.spec.js --project=firefox --project=webkit",
    "test:browser:update": "playwright test tests/browser/visual.spec.js --project=chromium --project=chromium-mobile --project=chromium-breakpoint --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.1.3",
    "vitest": "^4.1.11"
  }
}
